         return {
-            processedTokens: [...sortedTokensWithBalances, ...tokensWithoutBalances],
+            processedTokens: prioritizeFeaturedTokens([...sortedTokensWithBalances, ...tokensWithoutBalances], configTokens),
             withCategories: false,
         };
     }
